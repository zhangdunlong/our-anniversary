# ============================================================================
# _headers —— Cloudflare Pages 响应头配置
# ============================================================================

/*
  # 三重防索引：robots.txt + HTML meta + 响应头
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  # 禁止被 iframe 嵌套（防钓鱼页面套壳）
  X-Frame-Options: SAMEORIGIN
  # 不让浏览器猜 MIME 类型
  X-Content-Type-Options: nosniff
  # 只允许同源资源 + data:/blob:（海报导出用 blob:）
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# 静态资源：强缓存一年（文件名里没带 hash，所以用重新验证兜底）
/src/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/*
  Cache-Control: public, max-age=604800

# Service Worker 必须每次校验，否则更新发不出去
/sw.js
  Cache-Control: no-cache, must-revalidate

# HTML 不缓存，保证秒级看到最新内容
/index.html
  Cache-Control: no-cache, must-revalidate

# ============================================================================
# 后台管理区：禁止索引 + 禁止缓存 + 更严的 CSP
# ============================================================================
# Cloudflare Pages 的 _headers 规则里，越靠后的规则优先级越高。
# 所以后台的规则必须写在前台通用规则之后。

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Cache-Control: no-store, no-cache, must-revalidate
  X-Frame-Options: DENY
  # 后台不加载任何外部资源；connect-src 放开同源以便调用 /api/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

/admin/admin.js
  Cache-Control: no-store, no-cache, must-revalidate

/admin/admin.css
  Cache-Control: no-store, no-cache, must-revalidate

# ============================================================================
# API：绝不缓存（响应里也带了 no-store，这里是双保险）
# ============================================================================
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  X-Content-Type-Options: nosniff
